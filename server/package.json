{
  "name": "@wt/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "tick": "node dist/jobs/tick.js",
    "worker": "tsx --env-file-if-exists=.env src/jobs/worker.ts",
    "worker:prod": "node dist/jobs/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:db": "tsx scripts/dev-db.ts"
  },
  "dependencies": {
    "@wt/shared": "^1.0.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "mongoose": "^9.10.4",
    "nodemailer": "^10.0.14",
    "pino": "^10.4.0",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
