# Copy to server/.env for local development. Never commit .env files.

NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# `npm run dev:db` starts a local replica set at this URI (transactions need one). Or use Atlas:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/website_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27018/website_tracker?replicaSet=rs0

# Browser origin(s) allowed to call the API, comma-separated.
FRONTEND_URL=http://localhost:5173
# Number of reverse proxies in front of the API (Render: 1, local: 0 or 1).
TRUST_PROXY=1
# strict (default) | lax | none (none requires HTTPS and production)
COOKIE_SAMESITE=strict

# Bearer token for POST /api/internal/scheduler/tick (min 32 chars).
# Generate with: openssl rand -base64 48
SCHEDULER_SECRET=
SCHEDULER_CONCURRENCY=10
SCHEDULER_MAX_JOBS_PER_TICK=500

# Required once to create the first admin at /setup (min 16 chars). Remove afterwards.
SETUP_TOKEN=
# Allow anyone to self-register additional accounts.
ALLOW_REGISTRATION=false
# Development only: permit monitoring localhost/private IPs. Refused when NODE_ENV=production.
ALLOW_PRIVATE_TARGETS=false

# Email: none | resend | smtp. Render's free plan blocks SMTP ports — use resend there.
EMAIL_PROVIDER=none
EMAIL_FROM="Website Tracker <alerts@yourdomain.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
